{
  "uid": "pp-stt",
  "title": "pp-sketch STT (Bodhan)",
  "tags": ["pp-sketch", "stt"],
  "timezone": "browser",
  "schemaVersion": 39,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "env",
        "type": "custom",
        "label": "environment",
        "query": "staging,production",
        "current": {
          "text": "production",
          "value": "production"
        },
        "options": [
          {
            "text": "staging",
            "value": "staging",
            "selected": false
          },
          {
            "text": "production",
            "value": "production",
            "selected": true
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Bodhan success rate (1h)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.9
              },
              {
                "color": "green",
                "value": 0.98
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(pp_stt_request_duration_ms_milliseconds_count{provider=\"bodhan\", outcome=\"ok\", deployment_environment=\"$env\"}[1h])) / sum(increase(pp_stt_request_duration_ms_milliseconds_count{provider=\"bodhan\", deployment_environment=\"$env\"}[1h]))"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Bodhan calls (1h)",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(pp_stt_request_duration_ms_milliseconds_count{provider=\"bodhan\", deployment_environment=\"$env\"}[1h]))"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Bodhan outcomes / 5m",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 40
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "ok"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "rate_limited"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "rejected"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "decode"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{outcome}}",
          "expr": "sum by (outcome) (increase(pp_stt_request_duration_ms_milliseconds_count{provider=\"bodhan\", deployment_environment=\"$env\"}[5m]))"
        }
      ],
      "description": "rejected = clip ≥ 29 s, never sent to Bodhan; decode = Ogg/Opus → WAV failed before upload"
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Bodhan latency p50 / p95 / p99",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "p50",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(pp_stt_request_duration_ms_milliseconds_bucket{provider=\"bodhan\", deployment_environment=\"$env\"}[5m])))"
        },
        {
          "refId": "B",
          "legendFormat": "p95",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(pp_stt_request_duration_ms_milliseconds_bucket{provider=\"bodhan\", deployment_environment=\"$env\"}[5m])))"
        },
        {
          "refId": "C",
          "legendFormat": "p99",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(pp_stt_request_duration_ms_milliseconds_bucket{provider=\"bodhan\", deployment_environment=\"$env\"}[5m])))"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "All STT engines: HTTP client p95 (undici)",
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{server_address}}",
          "expr": "histogram_quantile(0.95, sum by (server_address, le) (rate(http_client_request_duration_seconds_bucket{service_name=\"pp-sketch\", deployment_environment=\"$env\", server_address=~\"api.bodhan.ai|api.sarvam.ai|.*speech.*|revapi.reverieinc.com\"}[5m]))) * 1000"
        }
      ]
    },
    {
      "id": 6,
      "type": "logs",
      "title": "Bodhan log lines (allowance, 429s, failures)",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"pp-sketch\", deployment_environment=\"$env\"} |~ \"Bodhan\""
        }
      ]
    }
  ]
}
